# Firebase migration environment

# Path to your Firebase Admin SDK service account JSON.
# Download from: Firebase console -> Project settings -> Service accounts -> Generate new private key
FIREBASE_CREDENTIALS=./firebase-credentials.json

# Optional: override the project id (auto-detected from the service account if omitted)
# FIREBASE_PROJECT_ID=your-project-id

# Public base URL used in SMS quotation links
BASE_URL=https://your-app.example.com

# Set to 1 to use the offline in-memory Firestore mock (no real Firebase project needed for testing).
# Leave unset / 0 for real Firebase.
# FIRESTORE_MOCK=1

# Gmail account used to send OTP, welcome, and password-reset emails.
# Use a Gmail App Password (Google Account -> Security -> App passwords), not your real password.
EMAIL_ADDRESS=your-app-gmail@gmail.com
EMAIL_PASSWORD=your-gmail-app-password

# Signs quotation-approval links AND password-reset links -- REQUIRED.
# The app now raises RuntimeError on boot if this is unset (outside
# FIRESTORE_MOCK/TESTING), since a missing/guessable value would make those
# links forgeable. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-value

# iProg SMS API token (utils/sms_utils.py). Get this from your iProg SMS
# account dashboard. SMS sending is disabled (send_sms returns an error,
# nothing crashes) if this is unset.
IPROG_API_HASH=your-iprog-api-token

# Set to 1 to auto-create the demo admin/staff/mechanic/customer accounts on
# boot (admin@automan.com / Admin123! etc.) -- and reset their passwords back
# to those fixed values on every restart. Leave unset on any deployment the
# public or a panel can reach; only turn on for local/dev testing.
# ALLOW_DEMO_ACCOUNTS=1
